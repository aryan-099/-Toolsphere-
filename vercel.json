{
  "version": 2,
  "builds": [
    {
      "src": "Toolsphere/zero/vercel_app.py",
      "use": "@vercel/python"
    },
    {
      "src": "Toolsphere/zero/staticfiles/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "Toolsphere/zero/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "Toolsphere/zero/vercel_app.py"
    }
  ]
}